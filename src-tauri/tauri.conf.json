{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "圣手编辑器",
  "mainBinaryName": "ShengShouBianJiQi",
  "version": "0.2.0",
  "identifier": "com.cherish.shengshoubianjiqi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "圣手编辑器",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "\u8f7b\u91cf\u6781\u901f\u7684\u4fbf\u7b7e\u7f16\u8f91\u5668",
    "longDescription": "圣手编辑器 — 轻量、极速、跨编码、Markdown 预览的便签 / 代码编辑器",
    "copyright": "© 2026 圣手编辑器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "signingIdentity": null,
      "entitlements": null
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "markdown",
          "rst"
        ],
        "name": "Text Documents",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "json",
          "yaml",
          "yml",
          "toml",
          "xml",
          "csv",
          "tsv"
        ],
        "name": "Data Documents",
        "role": "Editor"
      },
      {
        "ext": [
          "sql",
          "hql",
          "prql"
        ],
        "name": "SQL Scripts",
        "role": "Editor"
      },
      {
        "ext": [
          "js",
          "jsx",
          "ts",
          "tsx",
          "mjs",
          "cjs"
        ],
        "name": "JavaScript/TypeScript",
        "role": "Editor"
      },
      {
        "ext": [
          "py",
          "rb",
          "php",
          "java",
          "kt",
          "go",
          "rs",
          "c",
          "h",
          "cpp",
          "hpp",
          "cs",
          "swift"
        ],
        "name": "Source Code",
        "role": "Editor"
      },
      {
        "ext": [
          "html",
          "htm",
          "css",
          "scss",
          "sass",
          "less"
        ],
        "name": "Web Documents",
        "role": "Editor"
      },
      {
        "ext": [
          "sh",
          "bash",
          "zsh",
          "fish",
          "ps1"
        ],
        "name": "Shell Scripts",
        "role": "Editor"
      },
      {
        "ext": [
          "log",
          "diff",
          "patch",
          "env",
          "cfg",
          "conf",
          "ini"
        ],
        "name": "Config/Log Files",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMUI1NkNFMDQ0NDBGOUMKUldTY0QwUUV6bFliVTJUZ0F1NGZVYmI0b212SkFGSi9YbjRqcUhzL1I1eXlEVFVXOWx6eGpib1YK",
      "endpoints": [
        "https://gitee.com/princess-zp/shengShouNotPadPro/releases/download/latest/latest.json",
        "https://github.com/cherish-zp/shengShouNotPadPro/releases/latest/download/latest.json"
      ]
    },
    "process": {}
  }
}
