{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "NotePadPro",
  "version": "0.1.0",
  "identifier": "com.notepadpro.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NotePadPro",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "\u8f7b\u91cf\u6781\u901f\u7684\u4fbf\u7b7e\u7f16\u8f91\u5668",
    "longDescription": "NotePadPro \u2014 \u8f7b\u91cf\u3001\u6781\u901f\u3001\u8de8\u7f16\u7801\u3001Markdown \u9884\u89c8\u7684\u4fbf\u7b7e / \u4ee3\u7801 / \u7ec8\u7aef\u7f16\u8f91\u5668",
    "copyright": "\u00a9 2026 NotePadPro",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "signingIdentity": null,
      "entitlements": null
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "markdown",
          "rst"
        ],
        "name": "Text Documents",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "json",
          "yaml",
          "yml",
          "toml",
          "xml",
          "csv",
          "tsv"
        ],
        "name": "Data Documents",
        "role": "Editor"
      },
      {
        "ext": [
          "sql",
          "hql",
          "prql"
        ],
        "name": "SQL Scripts",
        "role": "Editor"
      },
      {
        "ext": [
          "js",
          "jsx",
          "ts",
          "tsx",
          "mjs",
          "cjs"
        ],
        "name": "JavaScript/TypeScript",
        "role": "Editor"
      },
      {
        "ext": [
          "py",
          "rb",
          "php",
          "java",
          "kt",
          "go",
          "rs",
          "c",
          "h",
          "cpp",
          "hpp",
          "cs",
          "swift"
        ],
        "name": "Source Code",
        "role": "Editor"
      },
      {
        "ext": [
          "html",
          "htm",
          "css",
          "scss",
          "sass",
          "less"
        ],
        "name": "Web Documents",
        "role": "Editor"
      },
      {
        "ext": [
          "sh",
          "bash",
          "zsh",
          "fish",
          "ps1"
        ],
        "name": "Shell Scripts",
        "role": "Editor"
      },
      {
        "ext": [
          "log",
          "diff",
          "patch",
          "env",
          "cfg",
          "conf",
          "ini"
        ],
        "name": "Config/Log Files",
        "role": "Editor"
      }
    ]
  }
}
